{
    "name": "pieceofcake2/filebinder",
    "description": "Simple file attachment plugin for CakePHP 2: local files, database and Amazon S3 storage",
    "type": "cakephp-plugin",
    "keywords": ["cakephp", "cakephp2", "file", "attachment", "upload", "s3"],
    "license": "MIT",
    "authors": [
        {
            "name": "fusic",
            "homepage": "https://github.com/fusic",
            "role": "Author"
        }
    ],
    "require": {
        "php": "^8.1",
        "composer/installers": "^1.0 || ^2.0",
        "pieceofcake2/cakephp": "^2.12"
    },
    "require-dev": {
        "async-aws/simple-s3": "^2.1 || ^3.0",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^9.6",
        "pieceofcake2/app": "^2.2",
        "pieceofcake2/async-aws": "^1.0",
        "pieceofcake2/aws": "^1.2",
        "pieceofcake2/phpcs-cakephp2": "^1.1",
        "pieceofcake2/phpstan-cakephp2": "^1.0"
    },
    "suggest": {
        "pieceofcake2/async-aws": "S3 storage with AsyncAws; also install async-aws/simple-s3",
        "async-aws/simple-s3": "Required with pieceofcake2/async-aws for the S3 storage (installs async-aws/s3)",
        "pieceofcake2/aws": "S3 storage with the AWS SDK for PHP (aws/aws-sdk-php)"
    },
    "replace": {
        "fusic/filebinder": "*"
    },
    "autoload-dev": {
        "exclude-from-classmap": [
            "vendor/pieceofcake2/app/src/Console/Command/AppShell.php"
        ]
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "composer/installers": true,
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    },
    "extra": {
        "installer-name": "Filebinder",
        "installer-paths": {
            "vendor/pieceofcake2/async-aws/": ["pieceofcake2/async-aws"],
            "vendor/pieceofcake2/aws/": ["pieceofcake2/aws"]
        }
    }
}
